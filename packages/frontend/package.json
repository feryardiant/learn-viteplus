{
  "name": "@learn-viteplus/frontend",
  "version": "0.0.1",
  "private": true,
  "description": "A shared front-end library for `learn-viteplus` Pages and Worker.",
  "license": "MIT",
  "author": "Fery Wardiyanto <ferywardiyanto@gmail.com>",
  "repository": {
    "directory": "packages/frontend"
  },
  "files": [
    "assets",
    "dist",
    "src",
    "style.css",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "style": "./style.css",
      "default": "./src/index.ts"
    },
    "./components": "./src/components.ts",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css",
    "./assets/*": "./assets/*",
    "./tsconfig.json": "./tsconfig.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "style": "./style.css",
        "default": "./dist/index.js"
      },
      "./components": "./dist/components.js",
      "./package.json": "./package.json",
      "./style.css": "./dist/style.css",
      "./assets/*": "./assets/*",
      "./tsconfig.json": "./tsconfig.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@fontsource-variable/roboto": "catalog:",
    "@learn-viteplus/shared": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}

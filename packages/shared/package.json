{
  "name": "@learn-viteplus/shared",
  "version": "0.0.1",
  "private": true,
  "description": "A shared configuration library for `learn-viteplus` Pages and Worker.",
  "license": "MIT",
  "author": "Fery Wardiyanto <ferywardiyanto@gmail.com>",
  "repository": {
    "directory": "packages/shared"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./dist/vite.mjs"
    },
    "./vitest-app": {
      "types": "./src/vitest-app.ts",
      "import": "./dist/vitest-app.mjs"
    },
    "./vitest-worker": {
      "types": "./src/vitest-worker.ts",
      "import": "./dist/vitest-worker.mjs"
    },
    "./package.json": "./package.json",
    "./tsconfig.json": "./tsconfig.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}

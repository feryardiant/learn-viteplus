{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-viteplus",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learn-viteplus-pages",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "learn-viteplus",
          "migrations_dir": "migrations",
        },
      ],
    },
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "learn-viteplus",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}

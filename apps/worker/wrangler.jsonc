{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-viteplus",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/main.ts",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learn-viteplus-worker",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "learn-viteplus",
          "migrations_dir": "migrations",
        },
      ],
    },
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "learn-viteplus",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
